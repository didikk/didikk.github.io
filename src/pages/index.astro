---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import SelectedWork from "../components/SelectedWork.astro";
import Experience from "../components/Experience.astro";
import TechnicalFocus from "../components/TechnicalFocus.astro";
import EngineeringPrinciples from "../components/EngineeringPrinciples.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main class="min-h-screen w-full bg-canvas pt-16" id="main">
    <div class="flex w-full flex-col">
      <Hero />
      <SelectedWork />
      <TechnicalFocus />
      <Experience />
      <EngineeringPrinciples />
      <About />
      <Contact />
    </div>
  </main>
  <Footer />
</BaseLayout>
