import TechnicalFocus from "../components/TechnicalFocus.astro";
import EngineeringPrinciples from "../components/EngineeringPrinciples.astro";
import About from "../components/About.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main class="pt-18" id="main">
    <Hero />
    <SelectedWork />
    <Experience />
    <TechnicalFocus />
    <EngineeringPrinciples />
    <About />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
