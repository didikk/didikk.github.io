---
import { hero, site } from "../data/site";

const ghost =
  "inline-flex min-h-[52px] items-center justify-center rounded-full px-[26px] no-underline transition-opacity hover:opacity-80";

// Screens in the collage are placeholders for real screenshots.
const phone =
  "rise rise-device absolute top-16 box-border flex h-[200px] w-24 flex-col justify-between rounded-[22px] border-[6px] border-frame px-[9px] py-3 text-white sm:top-[110px] sm:h-[280px] sm:w-[134px] lg:top-[130px] lg:h-[470px] lg:w-[230px] lg:rounded-[42px] lg:border-8 lg:px-[22px] lg:py-7";
const phoneName = "display text-[13px] leading-[1.05] tracking-normal lg:text-2xl";
const label = "hidden font-mono text-xs lg:inline";
---

<section id="top" class="overflow-hidden bg-night text-night-text">
  <div class="page-container">
    <div class="rise flex flex-col gap-[22px] pt-10 md:gap-8 md:pt-[88px]">
      <p class="flex flex-wrap items-center gap-x-5 gap-y-2.5 font-mono text-xs text-night-muted md:text-[13px]">
        <span class="inline-flex items-center gap-2 rounded-full border border-night-pill px-3 py-1.5">
          <span aria-hidden="true" class="status-dot size-[7px] rounded-full bg-accent"></span>
          {hero.status}
        </span>
        <span>{hero.role}</span>
        <span>{hero.location}</span>
      </p>
      <h1 class="display max-w-[13ch] text-[clamp(44px,7.6vw,116px)] leading-[0.94]">
        I keep mobile apps <span class="text-accent">maintainable</span>, from first release to full rewrite.
      </h1>
      <div class="flex flex-wrap items-end justify-between gap-8">
        <p class="max-w-[54ch] text-base text-night-muted md:text-[19px] md:leading-relaxed">{hero.body}</p>
        <div class="flex w-full flex-col gap-2.5 sm:w-auto sm:flex-row sm:flex-wrap sm:gap-3">
          <a href="#work" class={`${ghost} bg-accent font-semibold text-night`}>See selected work</a>
          <a href={`mailto:${site.email}`} class={`${ghost} border border-night-line font-medium`}>Email me</a>
        </div>
      </div>
    </div>

    <div
      aria-hidden="true"
      class="relative -mx-1.5 mt-12 -mb-[100px] h-[300px] sm:mx-auto sm:-mb-[130px] sm:h-[400px] sm:max-w-[680px] lg:mx-auto lg:mt-24 lg:-mb-[150px] lg:h-[600px] lg:max-w-[1080px]"
    >
      <div
        class="rise rise-device absolute inset-x-0 top-0 mx-auto box-border flex aspect-[4/3] w-[240px] flex-col justify-between rounded-[18px] border-[6px] border-frame bg-[#001E61] px-3.5 py-3 text-white sm:w-[460px] lg:inset-x-[170px] lg:aspect-auto lg:h-[540px] lg:w-auto lg:rounded-[36px] lg:border-[10px] lg:p-8"
        style="--delay:250ms"
      >
        <span class="display text-[15px] leading-[1.05] tracking-normal lg:text-[28px]">Synergy Kiosk App</span>
        <span class="hidden font-mono text-xs lg:inline">[Landscape tablet screenshot: kiosk]</span>
      </div>
      <div class={`${phone} left-0 bg-[#C62828]`} style="--tilt:-4deg;--delay:330ms">
        <span class={phoneName}>SiCepat Ekspres</span>
        <span class={label}>[Screenshot]</span>
      </div>
      <div class={`${phone} right-0 bg-[#1F6B45]`} style="--tilt:4deg;--delay:410ms">
        <span class={phoneName}>FarmByte Grow</span>
        <span class={label}>[Screenshot]</span>
      </div>
    </div>
  </div>
</section>
