---
import { principles, principlesIntro } from "../data/site";
import { toneBox } from "./tone";
---

<section
  class="w-full bg-surface-container-lowest section-y dark:bg-surface-card"
  id="principles"
>
  <div class="page-container">
    <div class="mb-12 flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span class="h-px w-6 bg-secondary"></span>
        <span class="section-eyebrow">Philosophy</span>
      </div>
      <h2 class="font-headline text-headline-lg tracking-tight text-on-surface">
        Engineering Principles
      </h2>
      <p class="max-w-2xl font-body text-body-md text-text-secondary">
        {principlesIntro}
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-4">
      {
        principles.map((principle) => (
          <div class="flex flex-col justify-between rounded-2xl bg-surface-card p-6 shadow-sm dark:bg-surface-elevated">
            <div>
              <div
                class:list={[
                  "mb-4 flex size-10 items-center justify-center rounded-xl",
                  toneBox[principle.tone],
                ]}
              >
                <span class="material-symbols-outlined text-[20px]">
                  {principle.icon}
                </span>
              </div>
              <h3 class="mb-2 font-headline text-headline-sm text-on-surface">
                {principle.title}
              </h3>
              <p class="font-body text-body-sm leading-relaxed text-text-secondary">
                {principle.body}
              </p>
            </div>
            <span class="mt-6 font-label text-[11px] tracking-wider text-text-muted uppercase">
              {principle.tag}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>
