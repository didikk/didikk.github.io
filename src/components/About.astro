---
import { about, principles } from "../data/site";
---

<section id="about" class="flex scroll-mt-6 flex-wrap gap-x-20 gap-y-12 py-[88px] md:py-[140px]">
  <div class="flex min-w-0 flex-[1_1_460px] flex-col gap-5 md:gap-7">
    <h2 class="font-mono text-xs text-muted md:text-[13px]">About</h2>
    <p class="font-display text-[clamp(32px,3.6vw,48px)] leading-[1.08] font-semibold tracking-[-0.035em]">{about.lead}</p>
    {about.paragraphs.map((text) => <p class="max-w-[52ch] text-base text-body md:text-[17px]">{text}</p>)}
    <p class="text-sm text-body md:text-[15px]">
      <span class="font-semibold text-ink">{about.education.school}</span><br />
      {about.education.detail}
    </p>
  </div>

  <div class="flex min-w-0 flex-[1_1_400px] flex-col gap-4">
    <h3 class="font-mono text-xs text-muted md:text-[13px]">How I work</h3>
    <p class="mb-2 font-display text-[21px] leading-[1.2] font-semibold tracking-[-0.02em] md:text-2xl">{about.howIWork}</p>
    <ol class="flex flex-col">
      {
        principles.map((p, i) => (
          <li
            class:list={[
              "flex gap-3.5 py-4 md:gap-5 md:py-5",
              i === 0 ? "border-t-2 border-ink" : "border-t border-rule",
              i === principles.length - 1 && "border-b border-b-rule",
            ]}
          >
            <span class="pt-1 font-mono text-xs text-muted md:text-[13px]">{String(i + 1).padStart(2, "0")}</span>
            <div>
              <div class="display text-[19px] tracking-[-0.02em] md:text-[21px]">{p.title}</div>
              <div class="text-sm text-body md:text-[15px]">{p.body}</div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
