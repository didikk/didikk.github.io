---
import { about } from "../data/site";
---

<section class="page-container section-y" id="about">
  <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-12">
    <div class="flex flex-col gap-5 lg:col-span-7">
      <div class="flex items-center gap-2">
        <span class="h-px w-6 bg-secondary"></span>
        <span class="section-eyebrow">Background</span>
      </div>
      <h2 class="font-headline text-headline-lg tracking-tight text-on-surface">
        About Didik
      </h2>
      <div
        class="space-y-4 font-body text-body-md leading-relaxed text-text-secondary"
      >
        {about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
    <div class="flex flex-col gap-6 lg:col-span-5">
      <div
        class="rounded-2xl bg-surface-card p-7 shadow-sm dark:bg-surface-elevated"
      >
        <div class="mb-4 flex items-center gap-3">
          <span class="material-symbols-outlined text-[26px] text-secondary"
            >school</span
          >
          <h3 class="font-headline text-headline-sm text-on-surface">
            Education
          </h3>
        </div>
        <div class="flex flex-col gap-1">
          <h4 class="font-body text-body-md font-semibold text-on-surface">
            {about.education.school}
          </h4>
          <span class="font-body text-body-sm text-text-secondary">
            {about.education.detail}
          </span>
          <span class="mt-1 font-label text-caption text-secondary">
            {about.education.years}
          </span>
        </div>
      </div>
      <div class="rounded-2xl bg-surface-container-low p-7 dark:bg-surface-card">
        <div class="mb-3 flex items-center gap-2">
          <span class="material-symbols-outlined text-[20px] text-emerald-500"
            >verified</span
          >
          <span
            class="font-eyebrow text-eyebrow tracking-wider text-on-surface uppercase"
          >
            Engineering Focus
          </span>
        </div>
        <p class="font-body text-body-sm leading-relaxed text-text-secondary">
          {about.engineeringFocus}
        </p>
      </div>
    </div>
  </div>
</section>
