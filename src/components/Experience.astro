---
import {
  experience,
  experienceIntro,
  tenureBlurb,
  totalTenureLabel,
} from "../data/site";
---

<section class="page-container section-y" id="experience">
  <div class="mb-12 flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="h-px w-6 bg-secondary"></span>
      <span class="section-eyebrow">Chronology</span>
    </div>
    <h2 class="font-headline text-headline-lg tracking-tight text-on-surface">
      Work Experience
    </h2>
    <p class="max-w-2xl font-body text-body-md text-text-secondary">
      {experienceIntro}
    </p>
  </div>

  <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-12 lg:gap-12">
    <aside class="hidden space-y-4 lg:col-span-4 lg:sticky lg:top-24 lg:block">
      <div class="rounded-2xl bg-surface-card p-5 shadow-sm dark:bg-surface-elevated">
        <span
          class="mb-4 block font-eyebrow text-eyebrow tracking-widest text-text-muted uppercase"
        >
          Company Index
        </span>
        <nav class="space-y-3 font-body text-body-sm">
          {
            experience.map((job) => (
              <a
                class="flex items-center justify-between text-on-surface transition-colors hover:text-secondary"
                href={`#exp-${job.id}`}
              >
                <span class="font-medium">{job.shortName}</span>
                <span class="font-label text-caption text-text-muted">
                  {job.indexLabel}
                </span>
              </a>
            ))
          }
        </nav>
      </div>
      <div
        class="rounded-2xl bg-surface-container-low p-5 dark:bg-surface-elevated/50"
      >
        <span
          class="mb-2 block font-eyebrow text-eyebrow tracking-widest text-text-muted uppercase"
        >
          Total Production Tenure
        </span>
        <p
          class="font-label text-headline-sm font-bold text-secondary"
        >
          {totalTenureLabel}
        </p>
        <p class="mt-1 font-body text-caption text-text-secondary">
          {tenureBlurb}
        </p>
      </div>
    </aside>

    <div class="flex flex-col gap-6 lg:col-span-8">
      {
        experience.map((job) => (
          <article
            class="rounded-2xl bg-surface-card p-7 shadow-sm dark:bg-surface-elevated"
            id={`exp-${job.id}`}
          >
            <div class="mb-3 flex flex-col justify-between gap-1 sm:flex-row sm:items-center">
              <h3 class="font-headline text-headline-sm text-on-surface">
                {job.company}
              </h3>
              <span class="font-label text-caption font-semibold text-secondary">
                {job.period}
              </span>
            </div>
            <p
              class="mb-4 font-eyebrow text-eyebrow tracking-wider text-text-muted uppercase"
            >
              {job.role}
            </p>
            {job.summary && (
              <p class="mb-4 font-body text-body-md leading-relaxed text-text-secondary">
                {job.summary}
              </p>
            )}
            {job.tags && job.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {job.tags.map((tag) => (
                  <span class="rounded-md bg-surface-container-low px-2.5 py-1 font-label text-caption text-on-surface dark:bg-badge">
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </article>
        ))
      }
    </div>
  </div>
</section>
