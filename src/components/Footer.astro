---
import { site } from "../data/site";
---

<footer class="w-full bg-surface-card py-space-xl">
  <div
    class="page-container flex flex-col items-center justify-between gap-gutter md:flex-row"
  >
    <div class="flex flex-col items-center gap-space-xs md:items-start">
      <span class="font-body text-body-sm text-on-surface">
        © 2026 {site.name}.
      </span>
      <span
        class="font-eyebrow text-eyebrow tracking-wide text-text-muted uppercase"
      >
        iOS & Android Architecture • Kotlin • Swift
      </span>
    </div>
    <div class="flex items-center gap-space-lg">
      <a
        class="font-label text-label-code text-on-surface-variant transition-colors hover:text-secondary"
        href={site.github}
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub
      </a>
      {
        site.linkedin && (
          <a
            class="font-label text-label-code text-on-surface-variant transition-colors hover:text-secondary"
            href={site.linkedin}
          >
            LinkedIn
          </a>
        )
      }
      {
        site.email && (
          <a
            class="font-label text-label-code text-on-surface-variant transition-colors hover:text-secondary"
            href={`mailto:${site.email}`}
          >
            Email
          </a>
        )
      }
    </div>
  </div>
</footer>
