---
import { nav, site } from "../data/site";

const pill =
  "inline-flex min-h-10 items-center rounded-full border border-night-line px-4 font-medium no-underline transition-colors hover:border-night-text";
---

<header id="site-header" class="sticky top-0 z-50 border-b border-transparent bg-night text-night-text">
  <div class="page-container">
    <div class="bar flex h-[68px] items-center justify-between gap-4 md:h-[88px]">
      <a href="#top" class="inline-flex items-center gap-2.5 no-underline md:gap-3">
        <span
          aria-hidden="true"
          class="display inline-flex size-8 items-center justify-center rounded-[9px] bg-accent text-[13px] font-extrabold tracking-normal text-night md:size-9 md:rounded-[10px] md:text-[15px]"
          >DI</span
        >
        <span class="text-[15px] font-semibold md:text-base">{site.name}</span>
      </a>

      <nav aria-label="Primary" class="desktop-nav hidden items-center gap-x-7 text-[15px] md:flex">
        {
          nav.map((item) => (
            <a href={item.href} class="nav-link relative py-2 text-night-muted no-underline transition-colors hover:text-night-text">
              {item.label}
            </a>
          ))
        }
        <a href={site.cv} class={pill} download>Download CV</a>
      </nav>

      <button
        type="button"
        id="menu-toggle"
        aria-expanded="false"
        aria-controls="menu-panel"
        class="min-h-11 min-w-11 rounded-full border border-night-line px-4 text-sm md:hidden"
      >
        Menu
      </button>
    </div>

    <div id="menu-panel" class="menu-panel md:hidden">
      <nav aria-label="Primary" class="overflow-hidden">
        <div class="flex flex-col border-t border-night-rule pb-4">
          {
            nav.map((item) => (
              <a href={item.href} class="nav-link flex min-h-12 items-center border-b border-night-rule text-lg no-underline">
                {item.label}
              </a>
            ))
          }
          <a href={site.cv} class={`${pill} mt-4 self-start`} download>Download CV</a>
        </div>
      </nav>
    </div>
  </div>
</header>

<style>
  #site-header {
    transition: border-color 0.2s;
  }

  #site-header[data-scrolled] {
    border-color: var(--color-night-rule);
  }

  /* Condense once the page moves, so the sticky bar takes less room. */
  .bar {
    transition: height 0.25s ease;
  }

  @media (min-width: 48rem) {
    [data-scrolled] .bar {
      height: 68px;
    }
  }

  /* Current section: text brightens and an accent rule draws in under the link. */
  .nav-link[aria-current="true"] {
    color: var(--color-night-text);
  }

  .desktop-nav .nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    border-radius: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }

  .desktop-nav .nav-link[aria-current="true"]::after {
    transform: scaleX(1);
  }

  .menu-panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.25s ease,
      visibility 0.25s;
  }

  [data-open] .menu-panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }
</style>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("menu-toggle");

  function setOpen(open: boolean) {
    header?.toggleAttribute("data-open", open);
    toggle?.setAttribute("aria-expanded", String(open));
    if (toggle) toggle.textContent = open ? "Close" : "Menu";
  }

  toggle?.addEventListener("click", () => setOpen(!header?.hasAttribute("data-open")));
  header?.querySelectorAll("#menu-panel a").forEach((link) => {
    link.addEventListener("click", () => setOpen(false));
  });

  const onScroll = () => header?.toggleAttribute("data-scrolled", window.scrollY > 8);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();

  // Mark the nav link for the section crossing the middle of the viewport.
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav-link")];
  const sections = [...new Set(links.map((a) => a.hash.slice(1)))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => !!el);

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        links.forEach((a) =>
          a.hash === `#${entry.target.id}` ? a.setAttribute("aria-current", "true") : a.removeAttribute("aria-current"),
        );
      }
    },
    { rootMargin: "-45% 0px -50% 0px" },
  );
  sections.forEach((s) => observer.observe(s));

  // Leaving the top of the page through the hero clears the marker.
  const hero = document.getElementById("top");
  if (hero) {
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting) links.forEach((a) => a.removeAttribute("aria-current"));
      },
      { rootMargin: "-45% 0px -50% 0px" },
    ).observe(hero);
  }
</script>
