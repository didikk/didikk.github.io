---
import { nav, site } from "../data/site";
---

<header
  class="fixed top-0 right-0 left-0 z-50 bg-surface-card shadow-[0_1px_8px_rgba(0,0,0,0.04)] dark:shadow-[0_1px_8px_rgba(0,0,0,0.35)]"
>
  <div
    class="page-container flex h-16 items-center justify-between gap-gutter"
  >
    <a class="group flex flex-col justify-center" href="/">
      <span
        class="font-headline text-headline-sm text-on-surface transition-colors group-hover:text-secondary"
      >
        {site.name}
      </span>
      <span
        class="font-eyebrow text-eyebrow tracking-wider text-text-muted uppercase"
      >
        {site.role}
      </span>
    </a>

    <nav class="hidden items-center gap-space-lg md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            class="nav-link font-body text-body-sm text-on-surface-variant transition-colors hover:text-on-surface"
            href={item.href}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-space-sm">
      <button
        type="button"
        id="theme-toggle"
        class="flex size-9 items-center justify-center rounded-lg bg-badge text-on-surface transition-colors hover:bg-surface-container dark:border dark:border-border-strong dark:bg-surface-elevated dark:text-text-secondary dark:hover:border-secondary dark:hover:text-secondary"
        aria-label="Toggle color mode"
      >
        <span
          class="material-symbols-outlined text-[20px]"
          id="theme-toggle-icon"
          aria-hidden="true">light_mode</span
        >
      </button>
      <a
        class="hidden items-center gap-space-xs rounded-lg bg-primary px-space-md py-space-xs font-body text-body-sm font-medium text-on-primary transition-all hover:opacity-90 sm:inline-flex"
        href={site.cv}
      >
        <span class="material-symbols-outlined text-[18px]">download</span>
        Download CV
      </a>

      <details class="relative md:hidden">
        <summary
          class="cursor-pointer list-none rounded-lg border border-border-subtle px-3 py-2 font-body text-body-sm text-on-surface-variant"
        >
          Menu
        </summary>
        <div
          class="absolute right-0 mt-space-sm w-48 rounded-xl border border-border-subtle bg-surface-card p-space-md shadow-sm"
        >
          <div class="flex flex-col gap-space-sm">
            {
              nav.map((item) => (
                <a
                  class="nav-link font-body text-body-sm text-on-surface-variant hover:text-on-surface"
                  href={item.href}
                >
                  {item.label}
                </a>
              ))
            }
            <a
              class="font-body text-body-sm text-on-surface-variant hover:text-on-surface"
              href={site.cv}
            >
              Download CV
            </a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  .nav-link.is-active {
    color: var(--color-secondary);
    font-weight: 600;
  }
</style>

<script>
  const THEME_KEY = "didik_theme";
  const themeIcon = document.getElementById("theme-toggle-icon");

  function isDark() {
    return document.documentElement.classList.contains("dark");
  }

  function syncThemeIcon() {
    if (themeIcon) {
      themeIcon.textContent = isDark() ? "dark_mode" : "light_mode";
    }
  }

  function setTheme(dark: boolean) {
    document.documentElement.classList.toggle("dark", dark);
    localStorage.setItem(THEME_KEY, dark ? "dark" : "light");
    syncThemeIcon();
  }

  syncThemeIcon();

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    setTheme(!isDark());
  });

  const links = [...document.querySelectorAll<HTMLAnchorElement>(".nav-link")];
  const sectionIds = [
    ...new Set(
      links
        .map((link) => link.getAttribute("href"))
        .filter((href): href is string => !!href?.startsWith("#"))
        .map((href) => href.slice(1)),
    ),
  ];

  function setActive(id: string) {
    links.forEach((link) => {
      const isActive = link.getAttribute("href") === `#${id}`;
      link.classList.toggle("is-active", isActive);
    });
  }

  function updateActive() {
    const offset = 96;
    const lastId = sectionIds.at(-1) ?? "";
    const last = document.getElementById(lastId);
    const lastTop = last?.getBoundingClientRect().top ?? Infinity;
    const scrolledToBottom =
      window.innerHeight + window.scrollY >=
      document.documentElement.scrollHeight - 8;

    if (scrolledToBottom || lastTop <= window.innerHeight * 0.55) {
      setActive(lastId);
      return;
    }

    const first = document.getElementById(sectionIds[0]);
    if (first && first.getBoundingClientRect().top > offset + 40) {
      setActive("");
      return;
    }

    let current = sectionIds[0] ?? "";
    for (const id of sectionIds) {
      const section = document.getElementById(id);
      if (section && section.getBoundingClientRect().top <= offset) {
        current = id;
      }
    }
    setActive(current);
  }

  document.querySelectorAll("header details a").forEach((link) => {
    link.addEventListener("click", () => {
      link.closest("details")?.removeAttribute("open");
    });
  });

  window.addEventListener("scroll", updateActive, { passive: true });
  window.addEventListener("hashchange", updateActive);
  updateActive();
</script>
