---
import { contact, site } from "../data/site";

const pill =
  "inline-flex min-h-11 items-center rounded-full border border-night-line px-[18px] text-[15px] no-underline transition-colors hover:border-night-text md:min-h-12 md:px-[22px] md:text-base";
---

<section id="contact" class="scroll-mt-6 bg-night text-night-text">
  <div class="page-container flex flex-col gap-5 pt-[72px] md:gap-7 md:pt-[120px]">
    <h2 class="font-mono text-xs text-night-muted md:text-[13px]">Contact</h2>
    <p class="display max-w-[18ch] text-[clamp(40px,5.4vw,80px)] leading-[0.98]">{contact.headline}</p>
    <p class="max-w-[52ch] text-base text-night-muted md:text-lg">{contact.body}</p>
    <a
      href={`mailto:${site.email}`}
      class="self-start font-display text-[clamp(25px,3.4vw,48px)] leading-[1.15] font-semibold tracking-[-0.03em] wrap-anywhere text-accent hover:opacity-80"
    >
      {site.email}
    </a>
    <div class="flex flex-wrap gap-2 md:gap-2.5">
      <a href={site.linkedin} class={pill}>LinkedIn ↗</a>
      <a href={site.github} class={pill}>GitHub ↗</a>
      <a href={site.cv} class={pill} download>Download CV</a>
    </div>
    <footer
      class="mt-14 flex flex-wrap justify-between gap-x-6 gap-y-2 border-t border-night-rule pt-[22px] pb-9 text-[13px] text-night-faint md:mt-24 md:pt-7 md:pb-10 md:text-sm"
    >
      <span>© {new Date().getFullYear()} {site.name}</span>
    </footer>
  </div>
</section>
