---
import { projects, selectedWorkIntro } from "../data/site";
import ProjectCard from "./ProjectCard.astro";
---

<section class="page-container pt-8 pb-16 md:pt-12 md:pb-24" id="work">
  <div class="mb-10 flex flex-col gap-3">
    <div class="flex items-center gap-2">
      <span class="h-px w-6 bg-secondary"></span>
      <span class="section-eyebrow">Portfolio</span>
    </div>
    <h2 class="font-headline text-headline-lg tracking-tight text-on-surface">
      Selected Work
    </h2>
    <p class="max-w-2xl font-body text-body-md text-text-secondary">
      {selectedWorkIntro}
    </p>
  </div>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard {...project} />)}
  </div>
</section>
