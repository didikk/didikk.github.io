---
interface Props {
  playStore?: string;
  appStore?: string;
  /** Pills on brand panels, plain text links on cards. */
  variant: "pill" | "text";
}

const { playStore, appStore, variant } = Astro.props;
const pill =
  "inline-flex min-h-11 items-center rounded-full px-4 text-sm font-medium no-underline transition-opacity hover:opacity-80 md:px-[18px] md:text-[15px]";
---

{
  (playStore || appStore) &&
    (variant === "pill" ? (
      <div class="flex flex-wrap gap-2.5">
        {playStore && (
          <a href={playStore} class={`${pill} bg-white text-ink`}>
            Google Play ↗
          </a>
        )}
        {appStore && (
          <a href={appStore} class={`${pill} border border-white`}>
            App Store ↗
          </a>
        )}
      </div>
    ) : (
      <div class="flex flex-wrap gap-x-[18px] text-sm font-medium">
        {playStore && (
          <a href={playStore} class="inline-flex min-h-11 items-center underline hover:opacity-80">
            Google Play ↗
          </a>
        )}
        {appStore && (
          <a href={appStore} class="inline-flex min-h-11 items-center underline hover:opacity-80">
            App Store ↗
          </a>
        )}
      </div>
    ))
}
