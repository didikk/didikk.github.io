---
import type { Shot } from "../data/types";

interface Props {
  shot: Shot;
  size: "card" | "feature";
  /** Featured phones alternate heights. */
  tall?: boolean;
}

const { shot, size, tall = false } = Astro.props;

// Screens without a screenshot show their label as a placeholder.
const screen = `relative flex items-center justify-center overflow-hidden border-ink bg-screen text-center text-muted ${shot.src ? "" : "p-4"}`;

// iPad: even bezel, aspect on the content box so the screen matches the 11" display.
const ipad = "box-content";

const card: Record<Shot["frame"], string> = {
  phone: "h-[230px] w-[170px] self-end rounded-t-[32px] border-[7px] border-b-0",
  "tablet-landscape": `${ipad} aspect-[1194/834] w-[206px] rounded-[18px] border-[7px]`,
  "tablet-portrait": `${ipad} aspect-[834/1194] w-[150px] rounded-[18px] border-[7px]`,
  tv: "h-[130px] w-[230px] rounded-lg border-[7px]",
  web: "h-[150px] w-[230px] rounded-xl border-[6px] border-t-[22px]",
};

const feature: Partial<Record<Shot["frame"], string>> = {
  // Radius is 18% of the width (vertical % = 18 × w/h), so it holds as the phone shrinks.
  phone: `${tall ? "aspect-[22/34] rounded-t-[18%_11.65%] md:aspect-[22/38] md:rounded-t-[18%_10.42%]" : "aspect-[22/30] rounded-t-[18%_13.2%] md:aspect-[22/34] md:rounded-t-[18%_11.65%]"} flex-[0_1_220px] border-8 border-b-0`,
  "tablet-landscape":
    `${ipad} mb-[clamp(28px,4vw,56px)] aspect-[1194/834] flex-[0_1_480px] rounded-[26px] border-[12px]`,
};
const frame = size === "feature" ? `text-[13px] ${feature[shot.frame]}` : `text-xs ${card[shot.frame]}`;
---

{
  size === "card" && shot.frame === "tv" ? (
    <div class="flex flex-col items-center">
      <div class={`${screen} ${frame}`}>
        {shot.src ? <img src={shot.src} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top" /> : `[${shot.label}]`}
      </div>
      <div class="h-[22px] w-2 bg-ink" />
      <div class="h-1.5 w-[90px] rounded-[3px] bg-ink" />
    </div>
  ) : (
    <div class={`${screen} ${frame}`}>
      {shot.src ? <img src={shot.src} alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top" /> : `[${shot.label}]`}
    </div>
  )
}
