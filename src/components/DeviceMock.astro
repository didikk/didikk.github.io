---
import type { Shot } from "../data/types";

interface Props {
  shot: Shot;
  size: "card" | "feature";
  /** Featured phones alternate heights. */
  tall?: boolean;
}

const { shot, size, tall = false } = Astro.props;

// Placeholder screens. Replace the label span with an <img> once screenshots exist.
const screen =
  "box-border flex items-center justify-center border-ink bg-screen p-4 text-center text-muted";

const card: Record<Shot["frame"], string> = {
  phone: "h-[230px] w-[170px] self-end rounded-t-[32px] border-[7px] border-b-0",
  "tablet-landscape": "h-[152px] w-[220px] rounded-[18px] border-[7px]",
  "tablet-portrait": "h-[236px] w-[170px] self-end rounded-t-[22px] border-[7px] border-b-0",
  tv: "h-[130px] w-[230px] rounded-lg border-[7px]",
  web: "h-[150px] w-[230px] rounded-xl border-[6px] border-t-[22px]",
};

const feature: Partial<Record<Shot["frame"], string>> = {
  phone: `${tall ? "aspect-[22/34] md:aspect-[22/38]" : "aspect-[22/30] md:aspect-[22/34]"} flex-[0_1_220px] rounded-t-[40px] border-8 border-b-0`,
  "tablet-landscape":
    "mb-[clamp(28px,4vw,56px)] aspect-[48/33] flex-[0_1_480px] rounded-[28px] border-8",
};
---

{
  size === "feature" ? (
    <div class={`${screen} text-[13px] ${feature[shot.frame]}`}>[{shot.label}]</div>
  ) : shot.frame === "tv" ? (
    <div class="flex flex-col items-center">
      <div class={`${screen} text-xs ${card.tv}`}>[{shot.label}]</div>
      <div class="h-[22px] w-2 bg-ink" />
      <div class="h-1.5 w-[90px] rounded-[3px] bg-ink" />
    </div>
  ) : (
    <div class={`${screen} text-xs ${card[shot.frame]}`}>[{shot.label}]</div>
  )
}
