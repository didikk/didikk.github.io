---
import type { Project } from "../data/types";
import DeviceMock from "./DeviceMock.astro";
import StoreLinks from "./StoreLinks.astro";

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="flex flex-col gap-3.5">
  <div
    aria-hidden="true"
    class="flex h-[280px] items-center justify-center gap-3 overflow-hidden rounded-[22px]"
    style={`background:${project.tone}`}
  >
    {project.shots.map((shot) => <DeviceMock shot={shot} size="card" />)}
  </div>
  <p class="mt-1.5 font-mono text-[13px] text-muted">{project.meta}</p>
  <h3 class="display text-[30px] leading-[1.05] tracking-[-0.03em]">{project.title}</h3>
  <p class="text-[15px] text-body">{project.description}</p>
  {
    project.role && (
      <p class="text-sm text-body">
        <span class="font-semibold text-ink">My role:</span> {project.role}
      </p>
    )
  }
  <p class="text-sm text-muted">{project.stack}</p>
  <StoreLinks playStore={project.playStore} appStore={project.appStore} variant="text" />
</article>
