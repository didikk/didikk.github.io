---
import type { Project } from "../data/types";
import { toneBox } from "./tone";

type Props = Project;
const { category, title, description, tags, tone, icon, playStore, appStore } =
  Astro.props;

const icons: Record<string, string> = {
  leaf: `<path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>`,
  truck: `<path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-5l-4-4h-3v10"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/>`,
  news: `<path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>`,
  card: `<rect height="14" rx="2" width="20" x="2" y="5"/><line x1="2" x2="22" y1="10" y2="10"/>`,
  pos: `<path d="M4 3h16a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1Z"/><path d="M8 7h8"/><path d="M8 11h8"/><path d="M8 15h5"/>`,
  map: `<path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/><circle cx="12" cy="10" r="3"/>`,
};

const iconKey =
  icon === "truck" ||
  icon === "news" ||
  icon === "card" ||
  icon === "pos" ||
  icon === "map"
    ? icon
    : "leaf";
---

<article
  class="group flex flex-col justify-between rounded-2xl bg-surface-card p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-xl dark:bg-surface-elevated motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <div>
    <div class="mb-4 flex items-start justify-between gap-4">
      <div class="flex flex-col">
        <span
          class="font-eyebrow text-eyebrow tracking-wider text-text-secondary uppercase"
        >
          {category}
        </span>
        <h3
          class="mt-1 font-headline text-headline-sm text-on-surface transition-colors group-hover:text-secondary"
        >
          {title}
        </h3>
      </div>
      <div
        class:list={[
          "flex size-12 shrink-0 items-center justify-center rounded-xl",
          toneBox[tone],
        ]}
      >
        <svg
          class="size-6"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
          set:html={icons[iconKey]}
        />
      </div>
    </div>
    <p
      class="mb-5 font-body text-body-sm leading-relaxed text-text-secondary"
    >
      {description}
    </p>
    <div class="mb-6 flex flex-wrap gap-1.5">
      {
        tags.map((tag) => (
          <span class="rounded-md bg-surface-container-low px-2.5 py-1 font-label text-[11px] text-on-surface dark:bg-badge">
            {tag}
          </span>
        ))
      }
    </div>
  </div>
  <div
    class="flex items-center justify-between border-t border-badge-border pt-4"
  >
    <div class="flex items-center gap-2">
      {
        playStore && (
          <a
            class="inline-flex items-center gap-1 font-label text-caption text-on-surface-variant transition-colors hover:text-secondary"
            href={playStore}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[16px]">play_arrow</span>
            Play Store
          </a>
        )
      }
      {
        playStore && appStore && (
          <span class="text-text-muted">·</span>
        )
      }
      {
        appStore && (
          <a
            class="inline-flex items-center gap-1 font-label text-caption text-on-surface-variant transition-colors hover:text-secondary"
            href={appStore}
            target="_blank"
            rel="noopener noreferrer"
          >
            <span class="material-symbols-outlined text-[16px]">phone_iphone</span>
            App Store
          </a>
        )
      }
    </div>
    <span
      class="material-symbols-outlined text-[18px] text-text-muted transition-transform group-hover:translate-x-0.5"
    >
      north_east
    </span>
  </div>
</article>
