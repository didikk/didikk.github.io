---
import { platforms } from "../data/site";
---

<section aria-labelledby="stack-h" class="pt-20 md:pt-[120px]">
  <h2 id="stack-h" class="mb-4 font-mono text-xs text-muted md:mb-6 md:text-[13px]">Platforms I ship on</h2>
  {
    platforms.map((p, i) => (
      <div
        class:list={[
          "flex flex-wrap items-baseline gap-x-10 gap-y-3 py-5 md:py-7",
          i === 0 ? "border-t-2 border-ink" : "border-t border-rule",
          i === platforms.length - 1 && "border-b border-b-rule",
        ]}
      >
        <div class="flex min-w-0 flex-[1_1_440px] flex-wrap items-baseline justify-between gap-x-4 gap-y-1 md:justify-start">
          <span class="display text-[clamp(36px,5vw,68px)] leading-none tracking-[-0.04em]">{p.name}</span>
          <span class="font-mono text-xs text-muted md:text-[13px]">{p.meta}</span>
        </div>
        <p class="flex-[1_1_380px] text-[15px] text-body md:text-base">{p.body}</p>
      </div>
    ))
  }
</section>
