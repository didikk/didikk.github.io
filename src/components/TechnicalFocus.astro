---
import {
  apiSkills,
  architectureSkills,
  cicdSkills,
  mobilePlatformSkills,
  performanceSkills,
  technicalFocusIntro,
} from "../data/site";
---

<section
  class="w-full bg-surface-container-lowest section-y dark:bg-surface-card"
  id="skills"
>
  <div class="page-container">
    <div class="mb-10 flex flex-col gap-3">
      <div class="flex items-center gap-2">
        <span class="h-px w-6 bg-secondary"></span>
        <span class="section-eyebrow">Capabilities</span>
      </div>
      <h2 class="font-headline text-headline-lg tracking-tight text-on-surface">
        Technical Focus
      </h2>
      <p class="max-w-2xl font-body text-body-md text-text-secondary">
        {technicalFocusIntro}
      </p>
    </div>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-12">
      <div
        class="flex flex-col justify-between rounded-2xl bg-surface-card p-7 shadow-sm md:col-span-7 dark:bg-surface-elevated"
      >
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span
              class="material-symbols-outlined text-[26px] text-secondary"
              >devices</span
            >
            <h3 class="font-headline text-headline-sm text-on-surface">
              Mobile Platform Mastery
            </h3>
          </div>
          <p class="mb-6 font-body text-body-sm text-text-secondary">
            React Native, Android, Flutter, and native bridges for shipping on
            iOS and Android from one codebase where it fits.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3">
          {
            mobilePlatformSkills.map((skill) => (
              <div class="flex flex-col rounded-xl bg-surface-container-low p-3 dark:bg-surface-card">
                <span class="font-label text-headline-sm font-semibold text-on-surface">
                  {skill.label}
                </span>
                <span class="font-body text-caption text-text-muted">
                  {skill.detail}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="flex flex-col justify-between rounded-2xl bg-surface-card p-7 shadow-sm md:col-span-5 dark:bg-surface-elevated"
      >
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span
              class="material-symbols-outlined text-[26px] text-secondary"
              >account_tree</span
            >
            <h3 class="font-headline text-headline-sm text-on-surface">
              Architecture & System Design
            </h3>
          </div>
          <p class="mb-6 font-body text-body-sm text-text-secondary">
            Keep business logic separate from UI so features can move without
            breaking unrelated modules.
          </p>
        </div>
        <div class="flex flex-col gap-2">
          {
            architectureSkills.map((skill) => (
              <div class="flex items-center justify-between rounded-lg bg-surface-container-low p-2.5 dark:bg-surface-card">
                <span class="font-body text-body-sm font-medium text-on-surface">
                  {skill.label}
                </span>
                <span class="font-label text-caption text-secondary">
                  {skill.detail}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="flex flex-col justify-between rounded-2xl bg-surface-card p-7 shadow-sm md:col-span-4 dark:bg-surface-elevated"
      >
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span
              class="material-symbols-outlined text-[26px] text-secondary"
              >speed</span
            >
            <h3 class="font-headline text-headline-sm text-on-surface">
              Performance & Profiling
            </h3>
          </div>
          <p class="mb-4 font-body text-body-sm text-text-secondary">
            Profile memory, UI thread, and list rendering when frames drop or
            devices struggle.
          </p>
        </div>
        <ul class="space-y-2.5 font-body text-body-sm text-on-surface">
          {
            performanceSkills.map((item) => (
              <li class="flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-emerald-500">
                  check_circle
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div
        class="flex flex-col justify-between rounded-2xl bg-surface-card p-7 shadow-sm md:col-span-4 dark:bg-surface-elevated"
      >
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span
              class="material-symbols-outlined text-[26px] text-secondary">api</span
            >
            <h3 class="font-headline text-headline-sm text-on-surface">
              APIs & Integrations
            </h3>
          </div>
          <p class="mb-4 font-body text-body-sm text-text-secondary">
            Client integrations for APIs, payments, analytics, and VoIP.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          {
            apiSkills.map((item) => (
              <span class="rounded-lg bg-surface-container-low px-3 py-1.5 font-label text-caption text-on-surface dark:bg-surface-card">
                {item}
              </span>
            ))
          }
        </div>
      </div>

      <div
        class="flex flex-col justify-between rounded-2xl bg-surface-card p-7 shadow-sm md:col-span-4 dark:bg-surface-elevated"
      >
        <div>
          <div class="mb-4 flex items-center gap-3">
            <span
              class="material-symbols-outlined text-[26px] text-secondary"
              >published_with_changes</span
            >
            <h3 class="font-headline text-headline-sm text-on-surface">
              CI/CD & DevOps
            </h3>
          </div>
          <p class="mb-4 font-body text-body-sm text-text-secondary">
            Pipelines and store tooling that cut manual release steps.
          </p>
        </div>
        <div class="flex flex-col gap-2">
          {
            cicdSkills.map((item) => (
              <div class="flex items-center gap-2 font-label text-label-code text-on-surface">
                <span class="size-2 rounded-full bg-secondary" />
                {item}
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
