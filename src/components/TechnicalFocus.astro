---
import { technicalFocus } from "../data/site";
import type { TechnicalFocusGroup } from "../data/types";

const icons: Record<TechnicalFocusGroup["icon"], string> = {
  phone:
    "M7 2.75A1.75 1.75 0 0 0 5.25 4.5v15A1.75 1.75 0 0 0 7 21.25h10A1.75 1.75 0 0 0 18.75 19.5v-15A1.75 1.75 0 0 0 17 2.75zm0 1.5h10c.14 0 .25.11.25.25v15a.25.25 0 0 1-.25.25H7a.25.25 0 0 1-.25-.25v-15c0-.14.11-.25.25-.25zM12 18.25a.75.75 0 1 1 0 1.5.75.75 0 0 1 0-1.5z",
  architecture:
    "M12 3.25 4.75 7.5v9L12 20.75l7.25-4.25v-9L12 3.25zm0 1.73 5.5 3.22v6.6L12 18.02l-5.5-3.22v-6.6L12 4.98zM12 9.25a2.75 2.75 0 1 0 0 5.5 2.75 2.75 0 0 0 0-5.5z",
  speed:
    "M12 4.25a7.75 7.75 0 1 0 6.9 4.24l-1.3.75A6.25 6.25 0 1 1 12 5.75V4.25zm.75 3.5v4.19l3.03 3.03-1.06 1.06-3.47-3.47V7.75z",
  api: "M8.25 7.5 4.5 12l3.75 4.5 1.14-.95L6.62 12l2.77-3.55zm7.5 0-1.14.95L17.38 12l-2.77 3.55 1.14.95L19.5 12zm-4.97 8.5.94-9.5h-1.44l.94 9.5z",
  build:
    "M20.03 7.47a4.5 4.5 0 0 1-6.36 6.36l-7.42 7.42-2.12-2.12 7.42-7.42a4.5 4.5 0 0 1 6.36-6.36l-2.12 2.12 1.06 1.06z",
  extension:
    "M9 3.75A2.25 2.25 0 0 1 11.25 6v.75H15A2.25 2.25 0 0 1 17.25 9v3.75H18a2.25 2.25 0 1 1 0 4.5h-.75V21A.75.75 0 0 1 16.5 21.75h-3.75V21a2.25 2.25 0 1 0-4.5 0v.75H4.5A.75.75 0 0 1 3.75 21v-3.75H4.5a2.25 2.25 0 1 0 0-4.5h-.75V9A2.25 2.25 0 0 1 6 6.75h3.75V6A2.25 2.25 0 0 1 9 3.75z",
};
---

<section class="page-container section-y">
  <div class="mb-md max-w-reading-width">
    <h2
      class="mb-base font-section-heading text-section-heading font-bold text-primary"
    >
      Technical Focus
    </h2>
  </div>
  <div class="grid grid-cols-1 gap-md sm:grid-cols-2 md:grid-cols-3">
    {
      technicalFocus.map((group) => (
        <div class="rounded-lg border border-surface-variant bg-surface-container-lowest p-md">
          <div class="mb-base flex items-center">
            <svg
              class="mr-base size-5 text-accent"
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
            >
              <path d={icons[group.icon]}></path>
            </svg>
            <h3 class="font-metadata text-metadata font-semibold uppercase tracking-widest text-primary">
              {group.title}
            </h3>
          </div>
          <ul class="space-y-xs font-body-md text-body-md text-on-surface-variant">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
